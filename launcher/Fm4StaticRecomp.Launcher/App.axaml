<!-- Adapted from Pinyon Shift's launcher (launcher/PinyonShift.Launcher.Desktop, BSD-3-Clause; see THIRD_PARTY_NOTICES.md). -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fm4StaticRecomp.Launcher.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- The game's own menu colours (src/ui/hostui/host_ui.cpp). -->
        <SolidColorBrush x:Key="LabelBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ValueBrush" Color="#ADADAF"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#959476"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D42E19"/>
        <SolidColorBrush x:Key="LineBrush" Color="#77776F"/>
        <SolidColorBrush x:Key="HelpBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="ScreenTitleBrush" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="StripEdgeBrush" Color="#6F6F6F"/>
        <SolidColorBrush x:Key="BackdropBrush" Color="#EB000000"/>
        <SolidColorBrush x:Key="SliderOutlineBrush" Color="#E1E1DE"/>
        <SolidColorBrush x:Key="SliderLowBrush" Color="#464642"/>
        <SolidColorBrush x:Key="SliderHighBrush" Color="#EEEEE8"/>
        <SolidColorBrush x:Key="WindowBrush" Color="#000000"/>
        <!-- Fluent's own accent (sliders, toggles, focus) in the game's red. -->
        <Color x:Key="SystemAccentColor">#D42E19</Color>
        <Color x:Key="SystemAccentColorDark1">#B82614</Color>
        <Color x:Key="SystemAccentColorDark2">#9A1F12</Color>
        <Color x:Key="SystemAccentColorDark3">#7C190E</Color>
        <Color x:Key="SystemAccentColorLight1">#E04A36</Color>
        <Color x:Key="SystemAccentColorLight2">#E86A58</Color>
        <Color x:Key="SystemAccentColorLight3">#F08C7E</Color>
        <!-- A strip: #14FFFFFF over the black window, opaque so dialogs can use it too. -->
        <SolidColorBrush x:Key="StripBrush" Color="#141414"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#262626"/>
        <!-- Barlow Condensed (SIL OFL 1.1, shipped), the look-alike of the game's Swiss 721 Condensed. -->
        <FontFamily x:Key="Body">avares://FM4StaticRecompLauncher/Assets/Fonts#Barlow Condensed</FontFamily>
        <!-- Pinyon's names, kept so its code reads the same. -->
        <StaticResource x:Key="SurfaceBrush" ResourceKey="StripBrush"/>
        <StaticResource x:Key="MutedBrush" ResourceKey="ValueBrush"/>
        <StaticResource x:Key="FaintBrush" ResourceKey="HelpBrush"/>
        <StaticResource x:Key="RedBrush" ResourceKey="AccentBrush"/>
        <StaticResource x:Key="FogBrush" ResourceKey="LabelBrush"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme/>
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.help">
            <Setter Property="Foreground" Value="{StaticResource HelpBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.stepTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.mark">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SliderLowBrush}"/>
        </Style>
        <Style Selector="TextBlock.mark.done">
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
        </Style>
        <Style Selector="TextBlock.mark.active, TextBlock.mark.failed">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="TextBlock.stepTitle.waiting">
            <Setter Property="Foreground" Value="{StaticResource HelpBrush}"/>
        </Style>
        <Style Selector="TextBlock.dialogTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- FM4's strips: a faint fill, a 1 px edge on top, square corners. -->
        <Style Selector="Border.strip">
            <Setter Property="Background" Value="{StaticResource StripBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StripEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="26,22"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="34,14"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8452F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SliderLowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        </Style>
        <Style Selector="Button.quiet:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SliderLowBrush}"/>
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <!-- The panel buttons under Play; the open one is marked in the accent colour. -->
        <Style Selector="Button.nav">
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
        </Style>
        <Style Selector="Button.link:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SliderLowBrush}"/>
        </Style>
        <Style Selector="ComboBox, TextBox, NumericUpDown">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Background" Value="{StaticResource SliderHighBrush}"/>
        </Style>
        <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Application.Styles>
</Application>
